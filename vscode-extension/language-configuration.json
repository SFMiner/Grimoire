{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["$SCROLL(", ")"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["$SCROLL(", ")"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(ritual|blessing|curse|formula|song|miracle|prank|artifact|relic|creature|construct|should|if|lest|else|while|for).*:$",
    "decreaseIndentPattern": "^\\s*(lest|else)\\s*:?.*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(ritual|blessing|curse|formula|song|miracle|prank|artifact|relic|creature|construct|should|if|while|for).*:$",
      "end": "^\\s*$"
    }
  },
  "wordPattern": "([a-zA-Z_$][a-zA-Z0-9_$]*)"
}