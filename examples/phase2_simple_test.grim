# Phase 2: Simple Communication Test
# Testing the core messaging and communication features

scry $SCROLL(=== Phase 2: Simple Communication Test ===)

# Test 1: Create familiars with messaging support
scry $SCROLL(Creating familiars...)

bind entity_familiar = summon upon $SCROLL(Entity), $SCROLL(EntityBot)
bind ai_familiar = summon upon $SCROLL(AI), $SCROLL(AIBot)

# Test 2: Basic familiar properties
scry $SCROLL(Testing basic properties...)
scry $SCROLL(Entity name: ) added to entity_familiar.name
scry $SCROLL(Entity true name: ) added to entity_familiar.true_name

scry $SCROLL(AI name: ) added to ai_familiar.name  
scry $SCROLL(AI true name: ) added to ai_familiar.true_name

# Test 3: Property management
scry $SCROLL(Testing property management...)

# The set_property method is a custom method on EntityFamiliar
# For testing, we'll use the command interface instead
command entity_familiar set_property upon $SCROLL(health), 100
command entity_familiar set_property upon $SCROLL(level), 5

scry $SCROLL(Properties set successfully)

# Test 4: Basic familiar commands
scry $SCROLL(Testing familiar commands...)

command entity_familiar activate
command ai_familiar activate

scry $SCROLL(Familiars activated)

# Test 5: Socket creation and linking
scry $SCROLL(Testing socket communication...)

# Note: Sockets are automatically created during familiar initialization
# We'll use the existing sockets for communication
scry $SCROLL(Using existing sockets for communication)

# Test 6: Message sending
scry $SCROLL(Testing message sending...)

# Send a message between familiars
send_familiar_message upon entity_familiar, $SCROLL(Hello from Entity!)

scry $SCROLL(Message sent successfully)

# Test 7: Familiar linking
scry $SCROLL(Testing familiar linking...)

# Link familiars for bidirectional communication
link_familiars upon entity_familiar, ai_familiar, $SCROLL(direct)

scry $SCROLL(Familiars linked successfully)

# Test 8: Basic inquiries
scry $SCROLL(Testing familiar inquiries...)

bind entity_state = entity_familiar.state
bind ai_state = ai_familiar.state

scry $SCROLL(Entity state: ) added to entity_state
scry $SCROLL(AI state: ) added to ai_state

# Test 9: Familiar capabilities
scry $SCROLL(Testing capabilities...)

bind entity_caps = entity_familiar.capabilities
bind ai_caps = ai_familiar.capabilities

scry $SCROLL(Entity has capabilities)
scry $SCROLL(AI has capabilities)

# Test 10: Socket information
scry $SCROLL(Testing socket information...)

bind entity_sockets = entity_familiar.sockets
bind ai_sockets = ai_familiar.sockets

scry $SCROLL(Entity has sockets)
scry $SCROLL(AI has sockets)

scry $SCROLL(=== Phase 2 Simple Test Complete ===)
scry $SCROLL(Core messaging functionality working!)
scry $SCROLL(- Familiar creation and setup)
scry $SCROLL(- Basic property access)
scry $SCROLL(- Socket creation and connection)
scry $SCROLL(- Message sending between familiars)
scry $SCROLL(- Familiar linking and communication)
scry $SCROLL(Ready for Phase 3 implementation!)